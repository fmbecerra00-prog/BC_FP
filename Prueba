/* ---------- Estado y memoria de cálculo ---------- */
let S=null, REV=0;
function touch(){REV++;scheduleSave();}
["diario","gasto","saldo","pendiente"].forEach(k=>{const f=E[k];E[k]=(St,r)=>{const t="__"+k;const c=r[t];if(c&&c.rev===REV)return c.v;const v=f(St,r);Object.defineProperty(r,t,{value:{rev:REV,v},enumerable:false,configurable:true,writable:true});return v;};});
const MEMO={};
function memo(key,fn){const c=MEMO[key];if(c&&c.rev===REV)return c.v;const v=fn();MEMO[key]={rev:REV,v};return v;}
const RES=soc=>memo("res"+soc,()=>E.resultado(S,soc));
const EQ=soc=>memo("eq"+soc,()=>E.equilibrio(S,soc));
const ES=()=>memo("es",()=>E.entreSociedades(S));

function normalize(s){
  const d=JSON.parse(JSON.stringify(SEED));
  const out={...d,...(s||{})};
  TABLES.forEach(t=>{if(!Array.isArray(out[t]))out[t]=[];out[t].forEach(r=>{if(!r.id)r.id=uid();});});
  ["tc","plan","units","cuentas"].forEach(k=>{if(!Array.isArray(out[k])||!out[k].length)out[k]=d[k];});
  while(out.tc.length<12)out.tc.push({usd:null,brl:null});
  out.pe=out.pe||d.pe;out.year=Number(out.year)||d.year;out.month=Number(out.month)||d.month;
  return out;
}

/* ---------- Acceso y guardado (Supabase) ---------- */
let sb=null,user=null,ROL=null,cloudVersion=null,saveTimer=null;
const isAdmin=()=>ROL==="admin";
function setSave(state,txt){$("saveDot").className="dot"+(state==="busy"?" busy":state==="err"?" err":"");$("saveTxt").textContent=txt;}
function scheduleSave(){setSave("busy","Guardando…");clearTimeout(saveTimer);saveTimer=setTimeout(saveNow,600);}
async function saveNow(){
  if(!sb||!user)return;
  try{
    const q=sb.from(CONFIG.TABLA).update({data:S,version:(cloudVersion||0)+1,updated_at:new Date().toISOString(),updated_by:user.id}).eq("id",1);
    const {data,error}=await (cloudVersion===null?q:q.eq("version",cloudVersion)).select("version");
    if(error)throw error;
    if(!data||!data.length)throw new Error("Otra persona guardó cambios mientras editabas. Copiá lo que cargaste y recargá la página.");
    cloudVersion=data[0].version;
    setSave("ok","Guardado · "+new Date().toLocaleTimeString("es-AR",{hour:"2-digit",minute:"2-digit"}));
  }catch(e){
    setSave("err","No se pudo guardar: "+(e.message||e));}
}
function showGate(msg,allowLogin=true){
  document.body.classList.remove("authed");$("gate").classList.remove("hidden");
  $("gateMsg").textContent=msg||"Esta página es de uso interno de Element Park. Solo pueden ingresar usuarios registrados con su correo y contraseña.";
  $("gateLoginBtn").classList.toggle("hidden",!allowLogin||!$("loginForm").classList.contains("hidden"));
  if(!allowLogin)$("loginForm").classList.add("hidden");
}
function loadScript(src){return new Promise((ok,ko)=>{const s=document.createElement("script");s.src=src;s.onload=ok;s.onerror=ko;document.head.appendChild(s);});}
async function boot(){
  if(!CONFIG.SUPABASE_URL||!CONFIG.SUPABASE_KEY){showGate("Esta página es de uso interno de Element Park. El acceso de usuarios todavía no está configurado.",false);return;}
  try{await loadScript("https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js");}catch(e){}
  if(!window.supabase){showGate("No se pudo conectar con el servidor de usuarios. Revisá la conexión a internet y recargá.",false);return;}
  sb=window.supabase.createClient(CONFIG.SUPABASE_URL,CONFIG.SUPABASE_KEY,{auth:{persistSession:true,storage:window.sessionStorage,storageKey:"ep_sesion",autoRefreshToken:true,detectSessionInUrl:true}});
  sb.auth.onAuthStateChange(ev=>{if(ev==="SIGNED_OUT"&&user){user=null;S=null;location.reload();}});
  const {data}=await sb.auth.getSession();
  if(data?.session?.user)return enter(data.session.user);
  showGate();
}
async function enter(u){
  user=u;
  // 1) ¿El correo está en la lista de usuarios habilitados? (RLS: solo un habilitado puede leer la lista)
  const {data:me,error:e1}=await sb.from(CONFIG.USUARIOS).select("email,nombre,rol,activo").eq("email",String(u.email||"").toLowerCase()).maybeSingle();
  if(e1||!me||me.activo===false){await sb.auth.signOut().catch(()=>{});user=null;
    showGate(e1&&!/0 rows/i.test(e1.message)?"No se pudo verificar el usuario: "+e1.message:`Usuario no registrado. El correo ${u.email} no está habilitado para acceder a esta página.`);return;}
  ROL=me.rol;
  // 2) Datos (también protegidos por RLS)
  const {data,error}=await sb.from(CONFIG.TABLA).select("data,version").eq("id",1).maybeSingle();
  if(error){showGate("No se pudieron leer los datos: "+error.message,false);return;}
  if(!data){
    if(!isAdmin()){showGate("El sistema todavía no tiene datos cargados. Pedile a la administración que importe la planilla.",false);return;}
    S=normalize(null);const ins=await sb.from(CONFIG.TABLA).insert({id:1,data:S,version:1,updated_by:u.id});
    if(ins.error){showGate("No se pudo inicializar la base: "+ins.error.message,false);return;}cloudVersion=1;
  }else{S=normalize(data.data);cloudVersion=data.version??null;}
  $("whoami").textContent=(me.nombre||u.email)+(isAdmin()?" · Administración":"");
  $("gate").classList.add("hidden");document.body.classList.add("authed");
  start();
  if(!S.diario.length&&!S.gastos.length&&isAdmin())setTimeout(()=>{if(confirm("La base está vacía. ¿Querés importar ahora la planilla «Cierres Element Park»?"))$("fileXlsx").click();},300);
}
