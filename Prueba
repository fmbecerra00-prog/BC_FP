  const pxRows=[...S.pasajeros].sort((a,b)=>a.unidad.localeCompare(b.unidad)||a.anio-b.anio).map(p=>[p.unidad,p.anio,...MESES.map((_,i)=>E.pasajerosMes(S,p.unidad,p.anio,i+1)||null),MESES.reduce((a,_,i)=>a+E.pasajerosMes(S,p.unidad,p.anio,i+1),0)]);
