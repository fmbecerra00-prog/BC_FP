  const row=(lab,a,kind)=>{const v=k=>a[k];return `<tr class="${kind||""}"><td>${lab}</td>${[bc,ar].map((R,ix)=>{const arr=R[a];const acc=arr.slice(0,m).reduce((s,x)=>s+x,0);const fn=a==="usd"?usd:money;return `<td class="n">${fn(arr[i])}</td><td class="n muted">${m>1?fn(arr[i-1]):"—"}</td><td class="n">${fn(acc)}</td>`;}).join("")}</tr>`;};
  $("pg-inicio").innerHTML=`
  <div class="page-head"><div><h2>Inicio · ${MESES[m-1]} ${y}</h2><p>Foto del cierre: saldos de cajas, cuentas pendientes, cómo viene el mes, pasajeros, fotos y la captación sobre los visitantes del Parque Nacional Iguazú.</p></div>
