/* ---------- Usuarios habilitados (solo administración, vía función segura) ---------- */
async function renderUsuarios(){
  const box=$("usrCard");if(!box)return;
  box.innerHTML='<h3>Usuarios habilitados</h3><p class="sub">Cargando…</p>';
  const {data,error}=await sb.from(CONFIG.USUARIOS).select("email,nombre,rol,activo,creado").order("email");
  if(error){box.innerHTML=`<h3>Usuarios habilitados</h3><p class="status err">${esc(error.message)}</p>`;return;}
  box.innerHTML=`<div><h3>Usuarios habilitados</h3><p class="sub" style="margin:2px 0 0">Nadie puede crearse una cuenta propia: solo la administración da de alta usuarios y define o cambia sus contraseñas.</p></div>
  <div class="grid g3" style="margin-top:12px">
    <div class="span2"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>Correo</th><th>Nombre</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody>
    ${data.map(u=>{const self=u.email.toLowerCase()===user.email.toLowerCase();return `<tr><td>${esc(u.email)}${self?' <span class="pill">vos</span>':""}</td><td>${esc(u.nombre||"")}</td>
      <td><select class="in" data-urol="${esc(u.email)}" style="width:140px" ${self?"disabled":""}><option value="usuario" ${u.rol==="usuario"?"selected":""}>Usuario</option><option value="admin" ${u.rol==="admin"?"selected":""}>Administración</option></select></td>
      <td>${u.activo===false?'<span class="pill bad">Bloqueado</span>':'<span class="pill ok">Activo</span>'}</td>
      <td style="white-space:nowrap"><button class="btn ghost sm" data-uclave="${esc(u.email)}">Cambiar contraseña</button> ${self?"":`<button class="btn ghost sm" data-uact="${esc(u.email)}" data-v="${u.activo===false?"1":"0"}">${u.activo===false?"Reactivar":"Bloquear"}</button> <button class="btn danger sm" data-udel="${esc(u.email)}">Eliminar</button>`}</td></tr>`;}).join("")}
    </tbody></table></div><p class="status" id="usrMsg"></p></div>
    <div><fieldset class="fs"><legend>Dar de alta un usuario</legend>
      <div class="field"><label>Correo electrónico</label><input class="in" id="nuMail" type="email" autocomplete="off"></div>
      <div class="field" style="margin-top:8px"><label>Nombre</label><input class="in" id="nuName" autocomplete="off"></div>
      <div class="field" style="margin-top:8px"><label>Contraseña (mín. 8)</label><input class="in" id="nuPass" type="text" autocomplete="off"><small>Se genera sola; podés cambiarla. Pasásela por un medio privado.</small></div>
      <div class="field" style="margin-top:8px"><label>Rol</label><select class="in" id="nuRol"><option value="usuario">Usuario (carga y consulta)</option><option value="admin">Administración (además usuarios, historial e importación)</option></select></div>
      <button class="btn" id="nuSave" style="margin-top:12px;width:100%;justify-content:center">Crear usuario</button>
      <p class="status" id="nuMsg"></p></fieldset></div></div>`;
  const msg=(id,t,err)=>{$(id).textContent=t;$(id).className="status "+(err?"err":"ok");};
  $("nuPass").value=genClave();
  $("nuSave").onclick=async()=>{
    const email=$("nuMail").value.trim().toLowerCase(),nombre=$("nuName").value.trim(),password=$("nuPass").value,rol=$("nuRol").value;
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))return msg("nuMsg","Escribí un correo válido.",1);
    if(password.length<8)return msg("nuMsg","La contraseña debe tener al menos 8 caracteres.",1);
    msg("nuMsg","Creando usuario…");$("nuSave").disabled=true;
    try{const r=await adminFn({accion:"crear",email,nombre,password,rol});msg("nuMsg",`Usuario ${email} habilitado`+(r.existia?" (ya tenía cuenta: se le asignó esta contraseña).":"."));setTimeout(renderUsuarios,1500);}
    catch(e){msg("nuMsg",e.message,1);}finally{$("nuSave").disabled=false;}
  };
  const act=async(body,ok)=>{msg("usrMsg","Aplicando…");try{await adminFn(body);msg("usrMsg",ok);renderUsuarios();}catch(e){msg("usrMsg",e.message,1);}};
  box.querySelectorAll("[data-uclave]").forEach(b=>b.onclick=()=>abrirClave(b.dataset.uclave));
  box.querySelectorAll("[data-urol]").forEach(s=>s.onchange=()=>act({accion:"rol",email:s.dataset.urol,rol:s.value},"Rol actualizado."));
