<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Element Park · Control de cierres</title>
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.sheetjs.com; connect-src 'self' https://dolarapi.com https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js" crossorigin="anonymous"></script>
<style>
:root{
  /* Bajo Cero = gama de azules */
  --bc-900:#0a2559;--bc-700:#1347a3;--bc-600:#1d5fd0;--bc-500:#3b82f6;--bc-300:#93c2ff;--bc-100:#e7f0ff;--bc-50:#f3f8ff;
  /* Arboris = gama de verdes */
  --ar-900:#0d3a21;--ar-700:#17733f;--ar-600:#1f8f50;--ar-500:#34b26a;--ar-300:#94dcb0;--ar-100:#e3f6ea;--ar-50:#f2fbf5;
  --ink:#152033;--ink-2:#334155;--muted:#6b7a90;--line:#e2e8f0;--line-2:#eef2f7;--bg:#f3f5f9;--card:#ffffff;
  --ok:#15803d;--bad:#c2410c;--warn:#b45309;--calc:#f1f4f8;
  --radius:16px;--shadow:0 1px 2px rgba(16,24,40,.04),0 6px 20px rgba(16,24,40,.06);
  --font:"Inter","Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:14px/1.45 var(--font);-webkit-font-smoothing:antialiased}
button,input,select,textarea{font:inherit;color:inherit}
.num,td.n,th.n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.hidden{display:none!important}
a{color:var(--bc-600)}
/* ---------- Encabezado ---------- */
header.top{background:linear-gradient(115deg,var(--bc-900) 0%,#0f3570 45%,#0f4a3a 78%,var(--ar-900) 100%);color:#fff;position:sticky;top:0;z-index:40;box-shadow:0 4px 18px rgba(10,20,40,.25)}
.top-inner{max-width:1500px;margin:auto;padding:14px 22px 0;display:flex;flex-wrap:wrap;align-items:center;gap:14px}
.brand{display:flex;align-items:center;gap:12px;flex:1;min-width:260px}
.logo{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,var(--bc-500),var(--ar-500));font-weight:800;letter-spacing:-.5px;box-shadow:inset 0 0 0 2px rgba(255,255,255,.25)}
.brand h1{font-size:19px;margin:0;letter-spacing:-.2px}
.brand p{margin:2px 0 0;font-size:12.5px;opacity:.78}
.period{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);padding:6px 8px 6px 12px;border-radius:12px}
.period label{font-size:12px;opacity:.85}
.period select{background:#fff;color:var(--ink);border:0;border-radius:8px;padding:6px 8px;font-weight:600}
.save-state{font-size:12px;opacity:.85;display:flex;align-items:center;gap:6px}
.dot{width:8px;height:8px;border-radius:50%;background:#4ade80;display:inline-block}
.dot.busy{background:#facc15}.dot.err{background:#f87171}
nav.tabs{max-width:1500px;margin:auto;padding:10px 16px 0;display:flex;gap:4px;overflow-x:auto;scrollbar-width:none}
nav.tabs button{background:transparent;border:0;color:#dbe7ff;padding:10px 16px;border-radius:12px 12px 0 0;font-weight:600;cursor:pointer;white-space:nowrap;display:flex;gap:7px;align-items:center}
nav.tabs button:hover{background:rgba(255,255,255,.08);color:#fff}
nav.tabs button.active{background:var(--bg);color:var(--ink)}
nav.tabs .ic{font-size:15px;opacity:.9}
main{max-width:1500px;margin:auto;padding:22px}
/* ---------- Tarjetas ---------- */
.page-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin:4px 0 18px}
.page-head h2{margin:0;font-size:24px;letter-spacing:-.4px}
.page-head p{margin:4px 0 0;color:var(--muted);max-width:760px}
.grid{display:grid;gap:16px}
.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}.g4{grid-template-columns:repeat(4,minmax(0,1fr))}
.g-auto{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.span2{grid-column:span 2}.span-all{grid-column:1/-1}
@media(max-width:1100px){.g4{grid-template-columns:repeat(2,minmax(0,1fr))}.g3{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.g2,.g3,.g4{grid-template-columns:1fr}.span2{grid-column:auto}main{padding:14px}}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);padding:18px 18px 16px;min-width:0;position:relative}
.card h3{margin:0 0 4px;font-size:15.5px;letter-spacing:-.1px;display:flex;align-items:center;gap:8px}
.card .sub{color:var(--muted);font-size:12.5px;margin:0 0 12px}
.card.bc{border-top:4px solid var(--bc-600)}.card.ar{border-top:4px solid var(--ar-600)}
.card.mix{border-top:4px solid transparent;border-image:linear-gradient(90deg,var(--bc-600),var(--ar-600)) 1;border-image-slice:1}
.card.mix{border-radius:0 0 var(--radius) var(--radius)}
.tag{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:3px 9px;border-radius:999px}
.tag.bc{background:var(--bc-100);color:var(--bc-700)}.tag.ar{background:var(--ar-100);color:var(--ar-700)}
.tag.gray{background:#eef1f6;color:#4b5a70}.tag.warn{background:#fff3e0;color:#9a4b00}.tag.bad{background:#fde8e1;color:#a3330b}.tag.ok{background:#dcf5e6;color:#11602f}
.kpi{border-radius:14px;padding:14px 16px;border:1px solid var(--line);background:#fff;min-width:0}
.kpi .l{font-size:12px;color:var(--muted);font-weight:600;display:flex;justify-content:space-between;gap:6px}
.kpi .v{font-size:23px;font-weight:750;letter-spacing:-.5px;margin-top:4px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.kpi .d{font-size:12px;margin-top:3px;color:var(--muted)}
.kpi.bc{background:linear-gradient(160deg,var(--bc-50),#fff 70%);border-color:#d5e5ff}.kpi.bc .v{color:var(--bc-900)}
.kpi.ar{background:linear-gradient(160deg,var(--ar-50),#fff 70%);border-color:#cdeedb}.kpi.ar .v{color:var(--ar-900)}
.kpi.dark{background:linear-gradient(135deg,#132544,#123a35);color:#fff;border:0}.kpi.dark .l,.kpi.dark .d{color:#c9d6ea}
.up{color:var(--ok)!important}.down{color:var(--bad)!important}
/* ---------- Tablas ---------- */
.tbl-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px;max-width:100%}
.tbl-wrap.tall{max-height:62vh}
table.tbl{width:100%;border-collapse:separate;border-spacing:0;font-size:13px}
.tbl th{position:sticky;top:0;z-index:2;background:#f7f9fc;color:#475569;font-weight:650;font-size:11.5px;text-transform:uppercase;letter-spacing:.03em;text-align:left;padding:10px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
.tbl td{padding:8px 10px;border-bottom:1px solid var(--line-2);vertical-align:middle}
.tbl tr:last-child td{border-bottom:0}
.tbl tbody tr:hover td{background:#fafcff}
.tbl td.calc,.tbl th.calc{background:var(--calc)}
.tbl th.calc::after{content:" ƒ";color:#94a3b8;font-style:italic;text-transform:none}
.tbl tr.row-bc td:first-child{box-shadow:inset 4px 0 0 var(--bc-500)}
.tbl tr.row-ar td:first-child{box-shadow:inset 4px 0 0 var(--ar-500)}
.tbl tr.tot td{font-weight:700;background:#f5f7fb;border-top:1px solid var(--line)}
.tbl tr.res td{font-weight:750;background:#eef4ff}
.tbl.ar-theme tr.res td{background:#eaf8ef}
.tbl tr.grp td{font-weight:650;cursor:pointer}
.tbl tr.grp td:first-child::before{content:"▸ ";color:var(--muted)}
.tbl tr.grp.open td:first-child::before{content:"▾ "}
.tbl tr.sub td:first-child{padding-left:28px;color:var(--ink-2)}
.tbl tr.head td{font-weight:800;color:var(--muted);text-transform:uppercase;font-size:11px;letter-spacing:.06em;background:#fff}
.tbl td.sel,.tbl th.sel{background:#fff8db!important}
.tbl .muted{color:var(--muted)}
.pill{display:inline-block;padding:2px 8px;border-radius:999px;font-size:11.5px;font-weight:650;background:#eef1f6;color:#475569;white-space:nowrap}
.pill.bc{background:var(--bc-100);color:var(--bc-700)}.pill.ar{background:var(--ar-100);color:var(--ar-700)}
.pill.warn{background:#fff1dc;color:#9a4b00}.pill.ok{background:#dcf5e6;color:#11602f}.pill.bad{background:#fde5dc;color:#a3330b}
/* ---------- Controles ---------- */
.btn{border:1px solid transparent;border-radius:10px;padding:8px 14px;font-weight:650;cursor:pointer;background:var(--bc-600);color:#fff;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.btn:hover{filter:brightness(1.07)}
.btn.ghost{background:#fff;color:var(--ink);border-color:var(--line)}
.btn.ghost:hover{background:#f7f9fc}
.btn.green{background:var(--ar-600)}.btn.danger{background:#fff;color:#b42318;border-color:#f3c4bd}
.btn.sm{padding:5px 10px;font-size:12.5px;border-radius:8px}
.btn:disabled{opacity:.55;cursor:not-allowed}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.field{display:flex;flex-direction:column;gap:5px;min-width:0}
.field label{font-size:12px;font-weight:650;color:var(--ink-2)}
.field small{color:var(--muted);font-size:11.5px}
input.in,select.in,textarea.in{border:1px solid #d6dde8;background:#fff;border-radius:10px;padding:8px 10px;width:100%;min-width:0}
input.in:focus,select.in:focus,textarea.in:focus{outline:2px solid var(--bc-300);border-color:var(--bc-500)}
input.cell{border:1px solid transparent;background:transparent;border-radius:6px;padding:4px 6px;width:110px;text-align:right;font-variant-numeric:tabular-nums}
input.cell:hover{border-color:#d6dde8;background:#fff}input.cell:focus{border-color:var(--bc-500);background:#fff;outline:none}
.seg{display:inline-flex;background:#e9edf4;border-radius:11px;padding:3px;gap:2px}
.seg button{border:0;background:transparent;padding:6px 14px;border-radius:9px;font-weight:650;cursor:pointer;color:#475569}
.seg button.on{background:#fff;color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.08)}
.seg button.on.bc{color:var(--bc-700)}.seg button.on.ar{color:var(--ar-700)}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:#fff;border-radius:12px;padding:9px 12px;cursor:pointer;text-align:left;display:flex;flex-direction:column;gap:2px;min-width:150px}
.chip b{font-size:13.5px}.chip span{font-size:11.5px;color:var(--muted)}
.chip.on{border-color:var(--bc-500);box-shadow:0 0 0 3px var(--bc-100)}
.note{background:#f6f9ff;border:1px solid #dbe7fb;color:#2b3f63;border-radius:12px;padding:10px 13px;font-size:12.8px}
.note.green{background:#f3fbf6;border-color:#cfeedd;color:#1d4d33}
.note.warn{background:#fff8ec;border-color:#f6dcb1;color:#7a4300}
.status{font-size:12.5px;color:var(--muted);min-height:18px}
.status.ok{color:var(--ok)}.status.err{color:var(--bad)}
.list{display:flex;flex-direction:column}
.list .it{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 0;border-bottom:1px dashed var(--line)}
.list .it:last-child{border-bottom:0}
.list .it .k{color:var(--ink-2);display:flex;gap:8px;align-items:center;min-width:0}
.list .it .v{font-weight:650;font-variant-numeric:tabular-nums;text-align:right}
.list .it .v small{display:block;font-weight:500;color:var(--muted);font-size:11.5px}
.bar{height:8px;border-radius:999px;background:#eef1f6;overflow:hidden;display:flex}
.bar i{display:block;height:100%}
.chart-box{position:relative;height:300px}
.chart-box.sm{height:220px}.chart-box.lg{height:360px}
.empty{padding:22px;text-align:center;color:var(--muted)}
.split{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.fx{font-size:30px;font-weight:800;letter-spacing:-.8px;font-variant-numeric:tabular-nums}
.fx small{font-size:13px;font-weight:600;color:var(--muted);letter-spacing:0}
.fx-row{display:flex;gap:18px;flex-wrap:wrap}
.flow{display:grid;grid-template-columns:1fr 40px 1fr 40px 1fr;align-items:stretch;gap:0}
.flow .col{display:flex;flex-direction:column;gap:8px}
.flow .arrow{display:grid;place-items:center;color:#94a3b8;font-size:22px}
.flow .box{border:1px solid var(--line);border-radius:12px;padding:9px 11px;background:#fff;font-size:12.8px}
.flow .box b{display:block;font-size:13px}
.flow .box.in{border-left:4px solid #64748b}.flow .box.cfg{border-left:4px solid #a855f7}.flow .box.out{border-left:4px solid var(--bc-600)}
@media(max-width:900px){.flow{grid-template-columns:1fr}.flow .arrow{transform:rotate(90deg);height:30px}}
dialog{border:0;border-radius:18px;padding:0;max-width:920px;width:96%;box-shadow:0 30px 80px rgba(10,20,40,.35)}
dialog::backdrop{background:rgba(12,22,40,.45)}
.dlg-h{padding:16px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:10px}
.dlg-h h3{margin:0}
.dlg-b{padding:18px 20px;max-height:68vh;overflow:auto}
.dlg-f{padding:14px 20px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px;background:#fafbfd}
.fs{border:1px solid var(--line);border-radius:12px;padding:12px 14px 14px;margin:0 0 12px}
.fs legend{font-weight:700;font-size:12.5px;padding:0 6px;color:var(--ink-2)}
.fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
.calc-preview{display:flex;gap:10px;flex-wrap:wrap}
.calc-preview .kpi{padding:10px 12px;background:var(--calc);border-style:dashed}
.calc-preview .kpi .v{font-size:16px}
body:not(.authed) .needs-auth{display:none!important}
body:not(.authed) header.top{position:static;box-shadow:none;background:transparent}
body:not(.authed){background:linear-gradient(135deg,#0a2559 0%,#0f3570 40%,#0f4a3a 75%,#0d3a21 100%);min-height:100vh}
body.authed #gate{display:none}
#gate{min-height:calc(100vh - 90px);display:grid;place-items:center;padding:24px}
.gate-card{background:#fff;border-radius:22px;box-shadow:0 30px 80px rgba(0,0,0,.35);padding:34px 32px;max-width:440px;width:100%;text-align:center}
.gate-card h1{margin:10px 0 8px;font-size:26px;letter-spacing:-.5px;color:#0a2559}
.gate-card p{color:var(--muted);margin:0 0 18px}
.gate-card form{text-align:left;margin-top:6px}
.gate-logo{width:56px;height:56px;margin:0 auto;font-size:20px;color:#fff}
.gate-lock{font-size:34px;margin-top:12px}
.user-box{display:flex;align-items:center;gap:8px;font-size:12.5px}
.user-box .btn.ghost{background:rgba(255,255,255,.12);color:#fff;border-color:rgba(255,255,255,.25)}
.legend-dot{width:10px;height:10px;border-radius:3px;display:inline-block}
footer{text-align:center;color:var(--muted);font-size:12px;padding:20px}
@media print{header.top,nav.tabs,.toolbar,.btn{display:none!important}body{background:#fff}.card{box-shadow:none;break-inside:avoid}}
</style>
</head>
<body>
<header class="top">
  <div class="top-inner">
    <div class="brand">
      <div class="logo">EP</div>
      <div><h1>Element Park · Control de cierres</h1><p><span style="color:var(--bc-300)">● Bajo Cero S.R.L.</span> &nbsp; <span style="color:var(--ar-300)">● Arboris S.R.L.</span></p></div>
    </div>
    <div class="period needs-auth">
      <label for="gMonth">Mes de cierre</label>
      <select id="gMonth"></select>
      <span id="gYear" style="font-weight:700"></span>
    </div>
    <div class="save-state needs-auth"><span id="saveDot" class="dot"></span><span id="saveTxt">Listo</span></div>
    <div class="user-box needs-auth"><span id="whoami"></span><button id="logoutBtn" class="btn ghost sm" type="button">Salir</button></div>
  </div>
  <nav class="tabs needs-auth" id="tabs"></nav>
</header>

<section id="gate">
  <div class="gate-card">
    <div class="logo gate-logo">EP</div>
    <div class="gate-lock">🔒</div>
    <h1>Usuario no registrado</h1>
    <p id="gateMsg">Esta página es de uso interno de Element Park. Solo pueden ingresar usuarios registrados con su correo y contraseña.</p>
    <button id="gateLoginBtn" class="btn ghost sm" type="button">Soy usuario registrado · Ingresar</button>
    <form id="loginForm" class="hidden" autocomplete="on">
      <div class="field"><label for="lgEmail">Correo electrónico</label><input class="in" id="lgEmail" type="email" autocomplete="username" required></div>
      <div class="field" style="margin-top:10px"><label for="lgPass">Contraseña</label><input class="in" id="lgPass" type="password" autocomplete="current-password" required></div>
      <button class="btn" style="width:100%;margin-top:16px;justify-content:center" type="submit">Iniciar sesión</button>
    </form>
    <p id="lgStatus" class="status"></p>
  </div>
</section>

<main id="app" class="needs-auth">
  <section id="pg-inicio" class="page"></section>
  <section id="pg-registros" class="page hidden"></section>
  <section id="pg-cambio" class="page hidden"></section>
  <section id="pg-estado" class="page hidden"></section>
  <section id="pg-resultados" class="page hidden"></section>
  <section id="pg-pasajeros" class="page hidden"></section>
  <section id="pg-config" class="page hidden"></section>
</main>
<footer class="needs-auth">Element Park · Bajo Cero (azules) · Arboris (verdes) · Los cálculos replican las fórmulas de la planilla «Cierres Element Park».</footer>

<dialog id="dlg"><form method="dialog" id="dlgForm" novalidate>
  <div class="dlg-h"><h3 id="dlgTitle">Registro</h3><button class="btn ghost sm" value="cancel" type="submit">✕</button></div>
  <div class="dlg-b" id="dlgBody"></div>
  <div class="dlg-f"><span id="dlgMsg" class="status" style="flex:1"></span><button class="btn ghost" value="cancel" type="submit">Cancelar</button><button class="btn" id="dlgSave" value="default" type="button">Guardar</button></div>
</form></dialog>
<dialog id="pwdDlg"><form method="dialog" id="pwdForm">
  <div class="dlg-h"><h3 id="pwTitle">Cambiar contraseña</h3><button class="btn ghost sm" value="cancel" type="submit">✕</button></div>
  <div class="dlg-b"><div class="field"><label>Nueva contraseña (mínimo 8 caracteres)</label><input class="in" type="text" id="pw1" autocomplete="off"><small>Pasásela a la persona por un medio privado.</small></div>
  <div class="field" style="margin-top:10px"><label>Repetir contraseña</label><input class="in" type="text" id="pw2" autocomplete="off"></div></div>
  <div class="dlg-f"><span id="pwMsg" class="status" style="flex:1"></span><button class="btn ghost" value="cancel" type="submit">Cancelar</button><button class="btn" id="pwSave" type="button">Guardar</button></div>
</form></dialog>
<input type="file" id="fileXlsx" accept=".xlsx,.xls,.xlsm" class="hidden">
<input type="file" id="fileJson" accept=".json,application/json" class="hidden">

<script>
"use strict";
/* =====================================================================
   ACCESO SOLO PARA USUARIOS REGISTRADOS (Supabase)
   1) Ejecutá el script «element_park_supabase.sql» en el SQL Editor de tu proyecto Supabase.
   2) Pegá abajo la URL del proyecto y la clave pública (anon / publishable).
   Sin sesión válida, la página solo muestra «Usuario no registrado».
   Los datos NO están dentro de este archivo: viven en Supabase, protegidos por RLS.
   ===================================================================== */
const CONFIG={
  SUPABASE_URL:"",      // ej. "https://xxxxxxxx.supabase.co"
  SUPABASE_KEY:"",      // clave pública anon / publishable (nunca la service_role)
  TABLA:"element_park_state",
  USUARIOS:"ep_usuarios"
};

/*ENGINE-START*/
/* ===== MOTOR DE CÁLCULO: replica las fórmulas del Excel "Cierres Element Park" ===== */
const MESES=["Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"];
const MES3=["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"];
const SOC_BC="Bajo Cero", SOC_AR="Arboris";
const GRUPOS_GASTO={"Bajo Cero":["Bar Frío","Bar Cálido","Fotografía","Bajo Cero","Expensas"],"Arboris":["Fly Park","Arboris","Expensas"]};
const NO_GASTO=["Entre sociedades","Otras cuentas del grupo","Cta. cte. socios","Inversiones y mejoras"];
const n=v=>{const x=typeof v==="number"?v:parseFloat(String(v??"").replace(",","."));return Number.isFinite(x)?x:0;};
const blank=v=>v===undefined||v===null||v==="";
const parseD=s=>{if(!s)return null;const m=String(s).match(/^(\d{4})-(\d{2})-(\d{2})/);return m?{y:+m[1],m:+m[2],d:+m[3]}:null;};
const E={
  tcUsd(S,m){return n(S.tc?.[m-1]?.usd);},
  tcBrl(S,m){return n(S.tc?.[m-1]?.brl);},
  socDeUnidad(S,u){const x=(S.units||[]).find(z=>z.unidad===u);return x?x.soc:"";},
  monedaCuenta(S,soc,cta){const x=(S.cuentas||[]).find(z=>z.soc===soc&&z.cuenta===cta);return x?x.moneda:"";},
  planDe(S,imp,tipo){return (S.plan||[]).find(p=>p.imput===imp&&p.tipo===tipo);},
  /* Diario: columnas grises */
  diario(S,r){
    const d=parseD(r.fecha);const mes=d?d.m:0,anio=d?d.y:0;
    const tickets=["may","men","agMay","agMen","te2040","te41","atMay","atMen","voucher"].reduce((a,k)=>a+n(r[k]),0);
    const efeR$=n(r.efeR)*E.tcBrl(S,mes), efeUsd$=n(r.efeUSD)*E.tcUsd(S,mes);
    const ingresos=n(r.efe)+efeR$+efeUsd$+n(r.tarjeta)+n(r.pweb);
    return {soc:E.socDeUnidad(S,r.unidad)||"⚠ unidad",tickets,ingresos,efeR$,efeUsd$,mes,anio,pax:tickets+n(r.menFree)+n(r.liberados),fotos:n(r.fotosImp)+n(r.fotosDig)};
  },
  /* Gastos: monto en $, % BC aplicado, reparto y control */
  gasto(S,r){
    const d=parseD(r.fecha);const mes=d?d.m:0,anio=d?d.y:0;
    const ars=r.moneda==="USD"?n(r.monto)*E.tcUsd(S,mes):r.moneda==="R$"?n(r.monto)*E.tcBrl(S,mes):n(r.monto);
    const p=E.planDe(S,r.imput,r.tipo);let pct=null,regla="";
    if(!blank(r.pctManual)){pct=n(r.pctManual);regla="Manual";}
    else if(p){if(typeof p.pct==="number"){pct=p.pct;regla="Plan de cuentas";}else{pct=r.paga===SOC_BC?1:0;regla="Paga";}}
    const bc=pct===null?0:ars*pct, ar=pct===null?0:ars-bc;
    const control=!p?"⚠ Imputación/tipo no existe":blank(r.pedido)?"⚠ Falta Nº de pedido":!blank(r.pctManual)?"Excepción al reparto":"OK";
    return {ars,pct,regla,bc,ar,mes,anio,control};
  },
  saldo(S,r){
    const d=parseD(r.fecha);const mes=d?d.m:0,anio=d?d.y:0;
    const moneda=E.monedaCuenta(S,r.soc,r.cuenta)||"⚠ cuenta";
    const usd=moneda==="USD"?n(r.saldo):(moneda==="R$"?n(r.saldo)*E.tcBrl(S,mes):n(r.saldo))/(E.tcUsd(S,mes)||NaN);
    return {moneda,usd:Number.isFinite(usd)?usd:0,mes,anio};
  },
  pendiente(S,r){
    const d=parseD(r.vto);const mes=d?d.m:12;
    const ars=r.moneda==="USD"?n(r.monto)*E.tcUsd(S,mes):r.moneda==="R$"?n(r.monto)*E.tcBrl(S,mes):n(r.monto);
    return {ars,mes};
  },
  /* Sumas por mes */
  ingresosUnidad(S,u,m,y=S.year){return S.diario.reduce((a,r)=>{const c=E.diario(S,r);return a+(r.unidad===u&&c.mes===m&&c.anio===y?c.ingresos:0);},0);},
  diarioSum(S,u,m,campo,y=S.year){return S.diario.reduce((a,r)=>{const c=E.diario(S,r);if(r.unidad!==u||c.mes!==m||c.anio!==y)return a;return a+(campo in c?c[campo]:n(r[campo]));},0);},
  gastoSum(S,soc,m,filtro,y=S.year){const k=soc===SOC_BC?"bc":"ar";return S.gastos.reduce((a,r)=>{const c=E.gasto(S,r);return a+(c.mes===m&&c.anio===y&&filtro(r,c)?c[k]:0);},0);},
  tiposDe(S,imp){return (S.plan||[]).filter(p=>p.imput===imp).map(p=>p.tipo);},
  /* Resultado de gestión por sociedad (hojas Resultado BC / Resultado Arboris) */
  resultado(S,soc){
    const M=[...Array(12)].map((_,i)=>i+1), rows=[];
    const unidades=(S.units||[]).filter(u=>u.soc===soc).map(u=>u.unidad);
    const ing=unidades.map(u=>({label:"Ingresos "+u,unidad:u,vals:M.map(m=>E.ingresosUnidad(S,u,m))}));
    const totIng=M.map((_,i)=>ing.reduce((a,r)=>a+r.vals[i],0));
    rows.push({label:"Ingresos",kind:"head"});ing.forEach(r=>rows.push({...r,kind:"item"}));rows.push({label:"Total ingresos",kind:"total",vals:totIng});
    rows.push({label:"Gastos",kind:"head"});
    const grupos=GRUPOS_GASTO[soc].map(g=>{
      const items=E.tiposDe(S,g).map(t=>({label:t,vals:M.map(m=>E.gastoSum(S,soc,m,r=>r.imput===g&&r.tipo===t))}));
      return {label:g,items,vals:M.map((_,i)=>items.reduce((a,x)=>a+x.vals[i],0))};
    });
    grupos.forEach(g=>{rows.push({label:g.label,kind:"group",vals:g.vals});g.items.forEach(it=>rows.push({...it,kind:"sub",grupo:g.label}));});
    const totG=M.map((_,i)=>grupos.reduce((a,g)=>a+g.vals[i],0));
    rows.push({label:"Total gastos",kind:"total",vals:totG});
    const res=M.map((_,i)=>totIng[i]-totG[i]);
    const inv=M.map(m=>E.gastoSum(S,soc,m,r=>r.imput==="Inversiones y mejoras"));
    const saldo=M.map((_,i)=>res[i]-inv[i]);
    const tc=M.map(m=>E.tcUsd(S,m));
    const usd=M.map((_,i)=>tc[i]?saldo[i]/tc[i]:0);
    rows.push({label:"Resultado del período",kind:"result",vals:res});
    rows.push({label:"Inversiones y mejoras",kind:"item",vals:inv});
    rows.push({label:"Saldo (resultado − inversiones)",kind:"result",vals:saldo});
    rows.push({label:"TC USD del mes",kind:"tc",vals:tc});
    rows.push({label:"Saldo en dólares",kind:"usd",vals:usd});
    let acc=0,accU=0;
    rows.push({label:"Saldo acumulado",kind:"acc",vals:saldo.map(v=>acc+=v)});
    rows.push({label:"Saldo acumulado en dólares",kind:"accusd",vals:usd.map(v=>accU+=v)});
    return {rows,totIng,totG,res,inv,saldo,usd,tc};
  },
  pasajerosMes(S,u,y,m){
    const h=(S.pasajeros||[]).find(p=>p.unidad===u&&p.anio===y);
    const v=h?h.m[m-1]:null;
    if(typeof v==="number")return v;
    if(u==="PN Iguazú"){const s=(S.pnDiario||[]).reduce((a,r)=>{const d=parseD(r.fecha);return a+(d&&d.y===y&&d.m===m?n(r.pax):0);},0);return s;}
    return E.diarioSum(S,u,m,"tickets",y);
  },
  equilibrio(S,soc){
    const R=E.resultado(S,soc),k=soc===SOC_BC?"bc":"ar",u=soc===SOC_BC?"Icebar":"Fly Park";
    const pe=S.pe?.[k]||{precio:[],cv:[]};
    const cf=R.totG,precio=[...Array(12)].map((_,i)=>n(pe.precio[i])),cv=[...Array(12)].map((_,i)=>n(pe.cv[i]));
    const pePax=cf.map((c,i)=>c===0?0:(precio[i]-cv[i])?c/(precio[i]-cv[i]):0);
    const pax=[...Array(12)].map((_,i)=>E.pasajerosMes(S,u,S.year,i+1));
    const avg=a=>{const p=a.filter(x=>x>0);return p.length?p.reduce((s,x)=>s+x,0)/p.length:0;};
    return {cf,precio,cv,pePax,pax,avg:{cf:avg(cf),precio:avg(precio),cv:avg(cv),pePax:avg(pePax),pax:avg(pax)}};
  },
  entreSociedades(S){
    const M=[...Array(12)].map((_,i)=>i+1);
    const a=M.map(m=>S.gastos.reduce((s,r)=>{const c=E.gasto(S,r);return s+(r.paga===SOC_BC&&c.mes===m&&c.anio===S.year?c.ar:0);},0));
    const b=M.map(m=>S.gastos.reduce((s,r)=>{const c=E.gasto(S,r);return s+(r.paga===SOC_AR&&c.mes===m&&c.anio===S.year?c.bc:0);},0));
    const t=(soc)=>M.map(m=>S.gastos.reduce((s,r)=>{const c=E.gasto(S,r);return s+(r.paga===soc&&r.imput==="Entre sociedades"&&c.mes===m&&c.anio===S.year?c.ars:0);},0));
    const c=t(SOC_BC),d=t(SOC_AR);
    const neto=M.map((_,i)=>a[i]-b[i]+c[i]-d[i]);let acc=n(S.esInicial);
    const saldo=neto.map(v=>acc+=v);
    const quien=saldo.map(v=>Math.round(v)===0?"Sin saldo":v>0?"Arboris debe a BC":"BC debe a Arboris");
    return {a,b,c,d,neto,saldo,quien};
  },
  saldosMes(S,m){
    const rows=S.saldos.filter(r=>{const c=E.saldo(S,r);return c.mes===m&&c.anio===S.year;});
    return rows;
  },
  ultimoMesConSaldos(S,m){for(let k=m;k>=1;k--)if(E.saldosMes(S,k).length)return k;return 0;},
  pendientesTot(S,soc,tipo){return S.pendientes.filter(r=>r.soc===soc&&r.tipo===tipo&&r.estado==="Pendiente").reduce((a,r)=>a+E.pendiente(S,r).ars,0);}
};
