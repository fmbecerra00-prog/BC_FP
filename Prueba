    options:{scales:{y:axisMoney,x:{grid:{display:false}}},plugins:{tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${money(Math.abs(c.parsed.y))}`}},legend:{position:"bottom",labels:{boxWidth:10}}}}});
