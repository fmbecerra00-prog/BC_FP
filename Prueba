const DIARIO_COLS={A:"fecha",B:"unidad",D:"detalle",E:"may",F:"men",G:"agMay",H:"agMen",I:"te2040",J:"te41",K:"atMay",L:"atMen",M:"voucher",O:"menFree",P:"liberados",Q:"web",R:"fotosImp",S:"fotosDig",T:"comensales",U:"efe",V:"efeR",W:"efeUSD",X:"tarjeta",Y:"pweb",AA:"difCaja"};
const GASTOS_COLS={A:"fecha",B:"pedido",C:"paga",D:"cuenta",E:"imput",F:"tipo",G:"detalle",H:"moneda",I:"monto",K:"pctManual"};
const SALDOS_COLS={A:"fecha",B:"soc",C:"cuenta",E:"saldo"};
const PEND_COLS={A:"tipo",B:"soc",C:"vto",D:"contraparte",E:"detalle",F:"cat",G:"moneda",H:"monto",J:"estado",K:"fcanc"};
const DATE_KEYS=["fecha","vto","fcanc"];
function xcell(ws,a){const c=ws&&ws[a];if(!c)return {v:null,f:null};return {v:c.v??null,f:c.f||null,t:c.t};}
function xdate(v){if(v===null||v===undefined||v==="")return null;if(typeof v==="number"){const d=XLSX.SSF.parse_date_code(v);return d?`${d.y}-${String(d.m).padStart(2,"0")}-${String(d.d).padStart(2,"0")}`:null;}
  const s=String(v);const m=s.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);if(m)return `${m[3]}-${m[2].padStart(2,"0")}-${m[1].padStart(2,"0")}`;const i=s.match(/^(\d{4}-\d{2}-\d{2})/);return i?i[1]:null;}
function readRows(ws,cols,start=5){
  if(!ws)return null;const rng=XLSX.utils.decode_range(ws["!ref"]||"A1");const out=[];
  for(let r=start;r<=rng.e.r+1;r++){const o={};let any=false;
    for(const [col,k] of Object.entries(cols)){const c=xcell(ws,col+r);if(c.f&&c.v===null)continue;let v=c.v;if(v===null||v==="")continue;
      if(DATE_KEYS.includes(k))v=xdate(v);else if(typeof v==="string"&&k!=="detalle"&&k!=="pedido")v=v.trim();
      if(v!==null&&v!==""){o[k]=v;any=true;}}
    if(any&&(o.fecha||o.tipo||o.unidad))out.push({id:uid(),...o});}
  return out;}
async function importExcelFile(f){
  if(typeof XLSX==="undefined"){alert("No se pudo cargar el lector de Excel (revisá internet).");return;}
  const wb=XLSX.read(await f.arrayBuffer(),{type:"array",cellFormula:true,cellDates:false});
  const sh=name=>wb.Sheets[wb.SheetNames.find(s=>s.trim().toLowerCase()===name.toLowerCase())];
  const next=JSON.parse(JSON.stringify(S));const done=[];
  const d=readRows(sh("Diario"),DIARIO_COLS);if(d){next.diario=d;done.push(`Diario: ${d.length}`);}
  const g=readRows(sh("Gastos"),GASTOS_COLS);if(g){g.forEach(r=>{if(r.monto!==undefined)r.monto=n(r.monto);if(r.pctManual!==undefined)r.pctManual=n(r.pctManual);});next.gastos=g;done.push(`Gastos: ${g.length}`);}
  const s=readRows(sh("Saldos"),SALDOS_COLS);if(s){next.saldos=s;done.push(`Saldos: ${s.length}`);}
  const p=readRows(sh("Pendientes"),PEND_COLS);if(p){next.pendientes=p;done.push(`Pendientes: ${p.length}`);}
  const px=sh("Pasajeros");if(px){const out=[];for(let r=15;r<=400;r++){const u=xcell(px,"A"+r).v,y=xcell(px,"B"+r).v;if(!["Icebar","Fly Park","PN Iguazú"].includes(u)||typeof y!=="number")continue;
    const m=["C","D","E","F","G","H","I","J","K","L","M","N"].map(c=>{const x=xcell(px,c+r);return x.f||typeof x.v!=="number"?null:x.v;});
    if(!out.some(o=>o.unidad===u&&o.anio===y))out.push({id:uid(),unidad:u,anio:y,m});}
    if(out.length){next.pasajeros=out;done.push(`Pasajeros: ${out.length} filas`);}}
  const cf=sh("Config");if(cf){
    const y=xcell(cf,"B4").v;if(typeof y==="number")next.year=y;
    next.tc=[...Array(12)].map((_,i)=>({usd:typeof xcell(cf,"C"+(7+i)).v==="number"?xcell(cf,"C"+(7+i)).v:null,brl:typeof xcell(cf,"D"+(7+i)).v==="number"?xcell(cf,"D"+(7+i)).v:null}));
    const plan=[];for(let r=31;r<=200;r++){const a=xcell(cf,"A"+r).v,b=xcell(cf,"B"+r).v,c=xcell(cf,"C"+r).v;if(a&&b&&typeof a==="string"&&!/^•|Cómo/.test(a))plan.push({imput:a.trim(),tipo:String(b).trim(),pct:typeof c==="number"?c:"Paga"});}
    if(plan.length)next.plan=plan;
    const units=[];for(let r=7;r<=12;r++){const a=xcell(cf,"F"+r).v,b=xcell(cf,"G"+r).v;if(a&&b)units.push({unidad:a,soc:b});}if(units.length)next.units=units;
    const ctas=[];for(let r=7;r<=40;r++){const a=xcell(cf,"I"+r).v,b=xcell(cf,"J"+r).v,c=xcell(cf,"K"+r).v;if(a&&b&&[SOC_BC,SOC_AR].includes(a))ctas.push({soc:a,cuenta:b,moneda:c||"$"});}if(ctas.length)next.cuentas=ctas;
    if(xcell(cf,"T6").v==="PUNTO DE EQUILIBRIO"){const row=r=>["U","V","W","X","Y","Z","AA","AB","AC","AD","AE","AF"].map(c=>xcell(cf,c+r).v);next.pe={bc:{precio:row(7),cv:row(8).map(v=>v||0)},ar:{precio:row(9),cv:row(10).map(v=>v||0)}};}
    done.push("Configuración");}
  const rb=sh("Resultado BC"),ra=sh("Resultado Arboris");const cols12=["B","C","D","E","F","G","H","I","J","K","L","M"];
  if(rb&&/precio/i.test(String(xcell(rb,"A61").v)))next.pe.bc={precio:cols12.map(c=>xcell(rb,c+61).v),cv:cols12.map(c=>n(xcell(rb,c+62).v))};
  if(ra&&/precio/i.test(String(xcell(ra,"A48").v)))next.pe.ar={precio:cols12.map(c=>xcell(ra,c+48).v),cv:cols12.map(c=>n(xcell(ra,c+49).v))};
  const es=sh("Entre sociedades");if(es&&typeof xcell(es,"B6").v==="number")next.esInicial=xcell(es,"B6").v;
  const extra=(name,keys)=>{const w=sh(name);if(!w)return;const rows=XLSX.utils.sheet_to_json(w,{defval:null});if(!rows.length)return;next[keys.t]=rows.map(r=>{const o={id:uid()};keys.c.forEach(([h,k])=>{let v=r[h];if(v===null||v===undefined||v==="")return;if(DATE_KEYS.includes(k))v=xdate(v);o[k]=v;});return o;}).filter(o=>o.fecha);done.push(`${name}: ${next[keys.t].length}`);};
  extra("PN Iguazu diario",{t:"pnDiario",c:[["Fecha","fecha"],["Visitantes PN","pax"],["Nota","nota"]]});
  extra("Caja Buenos Aires",{t:"cajaBA",c:[["Fecha","fecha"],["Sociedad","soc"],["Tipo","tipo"],["Comprobante","comprobante"],["Proveedor / cliente","contraparte"],["Moneda","moneda"],["Neto","neto"],["Alicuota","alic"],["Detalle","detalle"]]});
  extra("Cotizaciones",{t:"cotizaciones",c:[["Fecha","fecha"],["Oficial compra","oficialC"],["Oficial venta","oficialV"],["Blue compra","blueC"],["Blue venta","blueV"],["Real compra","brlC"],["Real venta","brlV"],["Fuente","fuente"]]});
  if(!done.length){alert("No se encontraron las solapas esperadas (Diario, Gastos, Saldos, Pendientes, Pasajeros, Config).");return;}
  if(!confirm("Se leyó:\n• "+done.join("\n• ")+"\n\n¿Reemplazar esos datos en el sistema?"))return;
  S=normalize(next);REV++;scheduleSave();$("gMonth").value=S.month;$("gYear").textContent=S.year;render();
}
