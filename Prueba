function go(id){PAGE=PAGES.some(p=>p[0]===id)?id:"inicio";if(location.hash!=="#"+PAGE)history.replaceState(null,"","#"+PAGE);
  document.querySelectorAll(".page").forEach(p=>p.classList.add("hidden"));$("pg-"+PAGE).classList.remove("hidden");renderTabs();render();window.scrollTo({top:0});}
function render(){try{RENDER[PAGE]();}catch(e){console.error(e);$("pg-"+PAGE).innerHTML=`<div class="card"><h3>Ocurrió un error al dibujar esta página</h3><p class="sub">${esc(e.message)}</p></div>`;}}
function start(){
  $("gMonth").innerHTML=MESES.map((m,i)=>`<option value="${i+1}">${m}</option>`).join("");
  $("gMonth").value=S.month;$("gYear").textContent=S.year;
  $("gMonth").onchange=()=>{S.month=Number($("gMonth").value);touch();render();};
  setSave("ok","Conectado · datos compartidos");
  go((location.hash||"#inicio").slice(1));
}
window.addEventListener("hashchange",()=>{if(!S)return;const h=location.hash.slice(1);if(h&&h!==PAGE)go(h);});

/* ---------- Gráficos ---------- */
const CH={};
function chart(id,cfg){
  const el=$(id);if(!el)return;
  if(!window.Chart){el.parentElement.innerHTML='<div class="empty">No se pudo cargar la librería de gráficos (revisá la conexión a internet).</div>';return;}
  CH[id]?.destroy();
  Chart.defaults.font.family=getComputedStyle(document.body).fontFamily;Chart.defaults.color="#475569";
  cfg.options=Object.assign({responsive:true,maintainAspectRatio:false,plugins:{legend:{position:"bottom",labels:{boxWidth:12,usePointStyle:true}}}},cfg.options||{});
  CH[id]=new Chart(el,cfg);
}
const axisMoney={ticks:{callback:v=>Math.abs(v)>=1e6?(v/1e6).toLocaleString("es-AR",{maximumFractionDigits:1})+" M":nf0.format(v)},grid:{color:"#eef1f6"}};
const ttMoney={callbacks:{label:c=>`${c.dataset.label||c.label}: ${money(c.parsed.y??c.parsed)}`}};

/* ---------- Helpers de datos ---------- */
const MON=()=>S.month, YR=()=>S.year;
const inPeriod=(c,per)=>c.anio===YR()&&(per==="anio"?c.mes<=MON():c.mes===MON());
function saldoCuenta(soc,cta,m){const r=S.saldos.filter(x=>x.soc===soc&&x.cuenta===cta).find(x=>{const c=E.saldo(S,x);return c.mes===m&&c.anio===YR();});return r?{saldo:n(r.saldo),...E.saldo(S,r)}:null;}

