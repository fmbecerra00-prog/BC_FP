function renderPN(){
  const m=MON(),y=YR(),days=new Date(y,m,0).getDate();
  const pnM=E.pasajerosMes(S,"PN Iguazú",y,m),bcM=E.pasajerosMes(S,"Icebar",y,m),fpM=E.pasajerosMes(S,"Fly Park",y,m);
  const hist=(S.pasajeros.find(p=>p.unidad==="PN Iguazú"&&p.anio===y)||{m:[]}).m[m-1];
  const rows=[];let sumPN=0,sumBC=0,sumFP=0;
  for(let d=1;d<=days;d++){
    const iso=`${y}-${String(m).padStart(2,"0")}-${String(d).padStart(2,"0")}`;
    const rec=S.pnDiario.find(r=>r.fecha===iso);const pn=rec?n(rec.pax):0;
    const bc=S.diario.filter(r=>r.fecha===iso&&r.unidad==="Icebar").reduce((a,r)=>a+E.diario(S,r).tickets,0);
    const fp=S.diario.filter(r=>r.fecha===iso&&r.unidad==="Fly Park").reduce((a,r)=>a+E.diario(S,r).tickets,0);
    sumPN+=pn;sumBC+=bc;sumFP+=fp;
    if(pnSoloDatos&&!pn&&!bc&&!fp)continue;
    const dow=new Date(y,m-1,d).toLocaleDateString("es-AR",{weekday:"short"});
    rows.push(`<tr><td>${dow} ${d}</td><td class="n"><input class="cell" type="number" min="0" step="1" data-pn="${iso}" value="${pn||""}" placeholder="cargar"></td>
      <td class="n">${num(bc)}</td><td class="n" style="color:var(--bc-700);font-weight:650">${pn?pct(bc/pn):"—"}</td>
      <td class="n">${num(fp)}</td><td class="n" style="color:var(--ar-700);font-weight:650">${pn?pct(fp/pn):"—"}</td>
      <td style="min-width:140px">${pn?`<div class="bar"><i style="width:${Math.min(100,bc/pn*100)}%;background:var(--bc-500)"></i><i style="width:${Math.min(100,fp/pn*100)}%;background:var(--ar-500)"></i></div>`:""}</td></tr>`);
  }
  $("pnCard").innerHTML=`<div class="split"><div><h3>Parque Nacional Iguazú · visitantes por día</h3><p class="sub" style="margin:0">Cargá cuántas personas visitaron el PN cada día. El sistema calcula qué porcentaje entró a <b style="color:var(--bc-700)">Bajo Cero (Icebar)</b> y a <b style="color:var(--ar-700)">Fly Park (Arboris)</b>.</p></div>
    <label class="toolbar" style="font-size:12.5px"><input type="checkbox" id="pnOnly" ${pnSoloDatos?"checked":""}> Mostrar solo días con datos</label></div>
  <div class="grid g4" style="margin:14px 0">
    <div class="kpi dark"><div class="l">Visitantes PN · ${MESES[m-1]}</div><div class="v">${num(pnM)}</div><div class="d">${typeof hist==="number"?"Dato mensual cargado en Pasajeros":"Suma de los días cargados"}${typeof hist==="number"&&sumPN?` · días: ${num(sumPN)}`:""}</div></div>
    <div class="kpi bc"><div class="l">Fueron a BC (Icebar)</div><div class="v">${num(bcM)}</div><div class="d">Captación: <b>${pnM?pct(bcM/pnM,2):"sin dato PN"}</b></div></div>
    <div class="kpi ar"><div class="l">Fueron a FP (Fly Park)</div><div class="v">${num(fpM)}</div><div class="d">Captación: <b>${pnM?pct(fpM/pnM,2):"sin dato PN"}</b></div></div>
    <div class="kpi"><div class="l">Reparto entre BC y FP</div><div class="v" style="font-size:18px"><span style="color:var(--bc-700)">${bcM+fpM?pct(bcM/(bcM+fpM),0):"—"}</span> / <span style="color:var(--ar-700)">${bcM+fpM?pct(fpM/(bcM+fpM),0):"—"}</span></div>
      <div class="bar" style="height:10px;margin-top:8px"><i style="width:${bcM+fpM?bcM/(bcM+fpM)*100:0}%;background:var(--bc-500)"></i><i style="width:${bcM+fpM?fpM/(bcM+fpM)*100:0}%;background:var(--ar-500)"></i></div><div class="d">Sobre el total que fue a alguno de los dos</div></div>
  </div>
  <div class="tbl-wrap" style="max-height:420px"><table class="tbl"><thead><tr><th>Día</th><th class="n">Visitantes PN</th><th class="n">Icebar (BC)</th><th class="n">% BC</th><th class="n">Fly Park (FP)</th><th class="n">% FP</th><th>Proporción</th></tr></thead>
  <tbody>${rows.join("")||`<tr><td colspan="7" class="empty">Sin datos diarios en ${MESES[m-1]}. Destildá «solo días con datos» para cargar cada día.</td></tr>`}</tbody>
  <tfoot><tr class="tot"><td>Total días</td><td class="n">${num(sumPN)}</td><td class="n">${num(sumBC)}</td><td class="n">${sumPN?pct(sumBC/sumPN):"—"}</td><td class="n">${num(sumFP)}</td><td class="n">${sumPN?pct(sumFP/sumPN):"—"}</td><td></td></tr></tfoot></table></div>
  <p class="note" style="margin-top:10px">Los pasajeros por día de BC y FP salen del <b>Diario de ventas</b> (tickets vendidos de esa fecha). Los meses que se cargaron como cierre mensual aparecen en el último día del mes.</p>`;
  $("pnOnly").onchange=e=>{pnSoloDatos=e.target.checked;renderPN();};
  $("pnCard").querySelectorAll("[data-pn]").forEach(inp=>inp.onchange=()=>{
    const iso=inp.dataset.pn,v=inp.value===""?null:Math.max(0,Math.round(n(inp.value)));
    const ix=S.pnDiario.findIndex(r=>r.fecha===iso);
    if(v===null||v===0){if(ix>=0)S.pnDiario.splice(ix,1);}else if(ix>=0)S.pnDiario[ix].pax=v;else S.pnDiario.push({id:uid(),fecha:iso,pax:v});
    touch();renderPN();});
}

