function calcBA(r){const neto=n(r.neto),iva=neto*n(r.alic??0)/100,total=neto+iva;const d=parseD(r.fecha)||{m:12};const k=r.moneda==="USD"?E.tcUsd(S,d.m):r.moneda==="R$"?E.tcBrl(S,d.m):1;return {iva,total,ars:total*k,ivaArs:iva*k,netoArs:neto*k};}
