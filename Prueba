let PX={u:"Icebar",var:false};
RENDER.pasajeros=function(){
  const y=YR(),m=MON(),u=PX.u;
  const years=[...new Set(S.pasajeros.filter(p=>p.unidad===u).map(p=>p.anio))].sort((a,b)=>a-b);
  if(!years.includes(y))years.push(y);
  const val=(yy,k)=>E.pasajerosMes(S,u,yy,k);
  const acc=(uu,yy)=>{let a=0;for(let k=1;k<=m;k++)a+=E.pasajerosMes(S,uu,yy,k);return a;};
  const pnAll=()=>{for(let k=1;k<=m;k++)if(!E.pasajerosMes(S,"PN Iguazú",y,k))return false;return true;};
  const max=Math.max(1,...years.flatMap(yy=>MES3.map((_,k)=>val(yy,k+1))));
  const shade=v=>{if(!v)return "";const a=(v/max);const base=u==="Fly Park"?"52,178,106":u==="Icebar"?"59,130,246":"100,116,139";return `background:rgba(${base},${(0.06+a*0.42).toFixed(2)})`;};
  const resumen=["Icebar","Fly Park","PN Iguazú"].map(uu=>{const a=E.pasajerosMes(S,uu,y,m),b=E.pasajerosMes(S,uu,y-1,m),c=acc(uu,y),d=acc(uu,y-1),pn=E.pasajerosMes(S,"PN Iguazú",y,m),pnA=acc("PN Iguazú",y);
    return `<tr class="row-${uu==="Icebar"?"bc":uu==="Fly Park"?"ar":""}"><td><b>${uu}</b></td><td class="n">${num(a)}</td><td class="n">${num(b)}</td><td class="n">${varTag(varPct(a,b))}</td><td class="n">${num(c)}</td><td class="n">${num(d)}</td><td class="n">${varTag(varPct(c,d))}</td><td class="n calc">${uu==="PN Iguazú"?"":pn?pct(a/pn,2):"sin dato PN"}</td><td class="n calc">${uu==="PN Iguazú"?"":pnAll()?pct(c/pnA,2):"faltan meses PN"}</td></tr>`;}).join("");
  $("pg-pasajeros").innerHTML=`
  <div class="page-head"><div><h2>Pasajeros</h2><p>Evolución histórica por unidad. Los meses del año en curso sin dato cargado se completan solos desde el Diario (marcados con ᵃ en Registros).</p></div>
    <div class="toolbar"><div class="seg">${["Icebar","Fly Park","PN Iguazú"].map(x=>`<button class="${x==="Icebar"?"bc":x==="Fly Park"?"ar":""} ${u===x?"on":""}" data-u="${x}">${x}</button>`).join("")}</div><button class="btn ghost sm" onclick="openReg('pasajeros')">Editar histórico</button></div></div>
  <div class="card mix"><h3>Resumen del cierre · ${MESES[m-1]} ${y}</h3>
    <div class="tbl-wrap" style="margin-top:8px"><table class="tbl"><thead><tr><th>Unidad</th><th class="n">Mes actual</th><th class="n">Mismo mes año ant.</th><th class="n">Var.</th><th class="n">Acum. ene–${MES3[m-1]}</th><th class="n">Acum. año ant.</th><th class="n">Var.</th><th class="n calc">% captación mes</th><th class="n calc">% captación acum.</th></tr></thead><tbody>${resumen}</tbody></table></div>
    <p class="note" style="margin-top:10px">La captación acumulada solo se calcula cuando están cargados todos los meses del Parque Nacional de enero al mes del cierre (Registros → Pasajeros o la carga diaria del PN en Inicio).</p></div>
  <div class="grid g3" style="margin-top:16px">
    <div class="card span2 ${u==="Icebar"?"bc":u==="Fly Park"?"ar":""}"><div class="split"><h3>${esc(u)} · pasajeros por mes</h3><label class="toolbar" style="font-size:12.5px"><input type="checkbox" id="pxVar" ${PX.var?"checked":""}> Mostrar variación % vs año anterior</label></div>
      <div class="tbl-wrap" style="margin-top:10px"><table class="tbl"><thead><tr><th>Año</th>${MES3.map((x,k)=>`<th class="n ${k===m-1?"sel":""}">${x}</th>`).join("")}<th class="n calc">Total</th><th class="n calc">Acum. ene–${MES3[m-1]}</th></tr></thead><tbody>
      ${years.slice().reverse().map(yy=>`<tr ${yy===y?'class="res"':""}><td><b>${yy}</b></td>${MES3.map((_,k)=>{const v=val(yy,k+1);if(PX.var){const b=val(yy-1,k+1);const vp=varPct(v,b);return `<td class="n">${vp===null?'<span class="muted">·</span>':varTag(vp)}</td>`;}return `<td class="n" style="${shade(v)}">${v?num(v):'<span class="muted">·</span>'}</td>`;}).join("")}<td class="n calc"><b>${num(MES3.reduce((a,_,k)=>a+val(yy,k+1),0))}</b></td><td class="n calc">${num(acc(u,yy))}</td></tr>`).join("")}
      </tbody></table></div></div>
    <div class="card"><h3>Comparación de años</h3><p class="sub">${y} vs ${y-1} y promedio histórico</p><div class="chart-box lg"><canvas id="chPx"></canvas></div></div>
  </div>
  <div class="card mix" style="margin-top:16px"><h3>Captación · % de los visitantes del Parque Nacional que entraron a cada atractivo · ${y}</h3>
    <div class="tbl-wrap" style="margin-top:8px"><table class="tbl"><thead><tr><th>Unidad</th>${MES3.map((x,k)=>`<th class="n ${k===m-1?"sel":""}">${x}</th>`).join("")}</tr></thead><tbody>
    <tr><td>Visitantes PN Iguazú</td>${MES3.map((_,k)=>`<td class="n">${num(E.pasajerosMes(S,"PN Iguazú",y,k+1))||"·"}</td>`).join("")}</tr>
    ${[["Icebar / PN","Icebar","bc"],["Fly Park / PN","Fly Park","ar"]].map(([l,uu,c])=>`<tr class="row-${c}"><td>${l}</td>${MES3.map((_,k)=>{const pn=E.pasajerosMes(S,"PN Iguazú",y,k+1),a=E.pasajerosMes(S,uu,y,k+1);return `<td class="n" style="color:var(--${c}-700);font-weight:650">${pn&&a?pct(a/pn,2):"·"}</td>`;}).join("")}</tr>`).join("")}
    </tbody></table></div></div>`;
  $("pg-pasajeros").querySelectorAll("[data-u]").forEach(b=>b.onclick=()=>{PX.u=b.dataset.u;render();});
  $("pxVar").onchange=e=>{PX.var=e.target.checked;render();};
  const pal=u==="Fly Park"?ARP:u==="Icebar"?BCP:["#334155","#64748b"];
  const prevYears=years.filter(yy=>yy<y&&MES3.some((_,k)=>val(yy,k+1)));
  const avg=MES3.map((_,k)=>{const l=prevYears.map(yy=>val(yy,k+1)).filter(v=>v>0);return l.length?l.reduce((a,v)=>a+v,0)/l.length:null;});
  chart("chPx",{type:"line",data:{labels:MES3,datasets:[{label:String(y),data:MES3.map((_,k)=>val(y,k+1)||null),borderColor:pal[1],backgroundColor:pal[1],tension:.3,borderWidth:3},{label:String(y-1),data:MES3.map((_,k)=>val(y-1,k+1)||null),borderColor:pal[4]||"#94a3b8",backgroundColor:pal[4]||"#94a3b8",tension:.3},{label:"Promedio histórico",data:avg,borderColor:"#94a3b8",borderDash:[5,4],pointRadius:0,tension:.3}]},options:{scales:{y:{grid:{color:"#eef1f6"}},x:{grid:{display:false}}}}});
};

