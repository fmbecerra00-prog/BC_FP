        <div class="kpi ar"><div class="l">Arboris · Neto</div><div class="v" style="font-size:18px">${money(pA.cob-pA.pag)}</div><div class="d">Cobrar ${money(pA.cob)}<br>Pagar ${money(pA.pag)}</div></div>
      </div>
