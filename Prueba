function drawRegTable(){
  const cfg=REG[RG.t],q=RG.q.trim().toLowerCase(),PS=60;
  let rows=S[RG.t].filter(r=>{
    if(RG.soc!=="all"&&cfg.soc(r)!==RG.soc)return false;
    if(RG.mes!=="all"&&cfg.date){const c=cfg.mes(r);if(c.mes!==Number(RG.mes))return false;}
    if(q&&!Object.values(r).some(v=>String(v??"").toLowerCase().includes(q)))return false;return true;});
  rows.sort((a,b)=>cfg.date?String(b[cfg.date]||"").localeCompare(String(a[cfg.date]||"")):(String(a.unidad).localeCompare(String(b.unidad))||n(b.anio)-n(a.anio)));
  const pages=Math.max(1,Math.ceil(rows.length/PS));RG.page=Math.min(RG.page,pages-1);
  const shown=rows.slice(RG.page*PS,RG.page*PS+PS);
  $("rgInfo").textContent=`${num(rows.length)} de ${num(S[RG.t].length)} registros`;
  $("rgTable").innerHTML=`<table class="tbl"><thead><tr>${cfg.cols.map(c=>`<th class="${c.n?"n ":""}${c.c?"calc":""}">${esc(c.l)}</th>`).join("")}<th></th></tr></thead><tbody>${
    shown.map(r=>`<tr class="row-${socCls(cfg.soc(r))}">${cfg.cols.map(c=>`<td class="${c.n?"n ":""}${c.c?"calc":""}">${c.v(r)}</td>`).join("")}<td style="white-space:nowrap"><button class="btn ghost sm" data-ed="${r.id}">Editar</button> <button class="btn danger sm" data-del="${r.id}" title="Eliminar">✕</button></td></tr>`).join("")||`<tr><td colspan="${cfg.cols.length+1}" class="empty">No hay registros con estos filtros.</td></tr>`}</tbody></table>`;
  $("rgTable").querySelectorAll("[data-ed]").forEach(b=>b.onclick=()=>openForm(RG.t,S[RG.t].find(r=>r.id===b.dataset.ed)));
  $("rgTable").querySelectorAll("[data-del]").forEach(b=>b.onclick=()=>{if(!confirm("¿Eliminar este registro? Los totales se recalculan."))return;S[RG.t]=S[RG.t].filter(r=>r.id!==b.dataset.del);touch();drawRegTable();});
  $("rgPager").innerHTML=pages>1?`<button class="btn ghost sm" ${RG.page?"":"disabled"} id="pgPrev">‹ Anterior</button><span class="muted">Página ${RG.page+1} de ${pages}</span><button class="btn ghost sm" ${RG.page<pages-1?"":"disabled"} id="pgNext">Siguiente ›</button>`:"";
  if(pages>1){$("pgPrev").onclick=()=>{RG.page--;drawRegTable();};$("pgNext").onclick=()=>{RG.page++;drawRegTable();};}
}
/* Formulario de alta / edición */
let FORM=null;
const getK=(o,k)=>k.startsWith("m.")?(o.m||[])[Number(k.slice(2))]:o[k];
const setK=(o,k,v)=>{if(k.startsWith("m.")){o.m=o.m||Array(12).fill(null);o.m[Number(k.slice(2))]=v;}else o[k]=v;};
function openForm(t,row){
  const cfg=REG[t];const draft=row?JSON.parse(JSON.stringify(row)):{id:uid()};
  if(!row){if(cfg.date)draft[cfg.date]=todayISO();if(t==="gastos"){draft.moneda="$";draft.paga=SOC_BC;}if(t==="pendientes"){draft.estado="Pendiente";draft.moneda="$";draft.tipo="A pagar";draft.soc=SOC_BC;}
    if(t==="cajaBA"){draft.moneda="$";draft.alic="21";draft.soc=SOC_BC;draft.tipo="IVA compras";}if(t==="saldos")draft.soc=SOC_BC;if(t==="pasajeros"){draft.anio=YR();draft.m=Array(12).fill(null);}}
  FORM={t,row,draft};
  $("dlgTitle").textContent=(row?"Editar · ":"Nuevo · ")+cfg.label;$("dlgMsg").textContent="";
  drawForm();
  $("dlg").showModal();
}
function drawForm(){
  const {t,draft}=FORM,cfg=REG[t];const groups={};
  cfg.fields.forEach(f=>{(groups[f.g||"Datos"]??=[]).push(f);});
  const input=f=>{const v=getK(draft,f.k);
    if(f.t==="select"){const opts=(typeof f.o==="function"?f.o(draft):f.o)||[];if(v&&!opts.includes(v))opts.push(v);
      return `<select class="in" data-k="${f.k}">${f.req&&v?"":'<option value="">— Elegir —</option>'}${opts.map(o=>`<option value="${esc(o)}" ${String(o)===String(v??"")?"selected":""}>${esc(o||"(sin especificar)")}</option>`).join("")}</select>`;}
    if(f.t==="date")return `<input class="in" type="date" data-k="${f.k}" value="${esc(v||"")}">`;
    if(f.t==="num")return `<input class="in num" type="number" step="any" data-k="${f.k}" value="${v??""}">`;
    if(f.t==="pct")return `<input class="in num" type="number" step="any" min="0" max="100" data-k="${f.k}" data-pct="1" value="${v===undefined||v===null||v===""?"":n(v)*100}" placeholder="vacío = plan">`;
    return `<input class="in" type="text" data-k="${f.k}" value="${esc(v||"")}">`;};
  $("dlgBody").innerHTML=Object.entries(groups).map(([g,fs])=>`<fieldset class="fs"><legend>${esc(g)}</legend><div class="fgrid">${fs.map(f=>`<div class="field" ${f.wide?'style="grid-column:span 2"':""}><label>${esc(f.l)}${f.req?' <span style="color:#c2410c">*</span>':""}</label>${input(f)}${f.h?`<small>${esc(f.h)}</small>`:""}</div>`).join("")}</div></fieldset>`).join("")+
    `<fieldset class="fs" style="background:#fafbfd"><legend>Cálculos automáticos (ƒ)</legend><div class="calc-preview" id="calcPrev"></div></fieldset>`;
  const upd=()=>{try{$("calcPrev").innerHTML=cfg.calc(draft).map(([l,v])=>`<div class="kpi"><div class="l">${esc(l)}</div><div class="v">${esc(v)}</div></div>`).join("");}catch(e){$("calcPrev").textContent="";}};
  $("dlgBody").querySelectorAll("[data-k]").forEach(el=>el.onchange=()=>{
    const f=cfg.fields.find(x=>x.k===el.dataset.k);let v=el.value;
    if(f.t==="num")v=v===""?(f.k.startsWith("m.")?null:undefined):n(v);
    if(f.t==="pct")v=v===""?undefined:n(v)/100;
    if(v===undefined)delete draft[f.k];else setK(draft,f.k,v);
    if(cfg.fields.some(x=>x.dep===f.k)){cfg.fields.filter(x=>x.dep===f.k).forEach(x=>{const opts=x.o(draft);if(!opts.includes(draft[x.k]))draft[x.k]=x.req?opts[0]||"":"";});drawForm();return;}
