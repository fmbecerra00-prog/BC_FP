  box.innerHTML=`<div class="split"><div><h3>Historial de versiones</h3><p class="sub" style="margin:2px 0 0">Supabase guarda una versión cada vez que alguien guarda (los guardados seguidos de una misma persona dentro de 5 minutos se agrupan). Se conservan las últimas 300. Restaurar no borra nada: lo actual también queda en el historial.</p></div><button class="btn ghost sm" id="histRef">↻ Actualizar</button></div>
  <div class="tbl-wrap tall" style="margin-top:10px"><table class="tbl"><thead><tr><th>Fecha y hora</th><th class="n">Versión</th><th>Quién guardó</th><th>Detalle</th><th class="n">Tamaño</th><th></th></tr></thead><tbody>
  ${data.map((h,k)=>`<tr ${k===0?'class="res"':""}><td>${esc(new Date(h.guardado_en).toLocaleString("es-AR"))}</td><td class="n">${esc(h.version??"")}</td><td>${esc(h.guardado_por_email||"")}</td><td class="muted">${k===0?'<span class="pill ok">Actual</span> ':""}${esc(h.motivo||"")}</td><td class="n">${num((h.tamano||0)/1024)} KB</td>
    <td style="white-space:nowrap"><button class="btn ghost sm" data-hdown="${h.hist_id}">Descargar</button> ${k===0?"":`<button class="btn sm" data-hrest="${h.hist_id}">Restaurar</button>`}</td></tr>`).join("")||'<tr><td colspan="6" class="empty">Todavía no hay versiones guardadas.</td></tr>'}
  </tbody></table></div>`;
  $("histRef").onclick=renderHistorial;
  box.querySelectorAll("[data-hdown]").forEach(b=>b.onclick=async()=>{b.disabled=true;const {data:h,error:e}=await sb.from("element_park_historial").select("data,guardado_en").eq("hist_id",+b.dataset.hdown).maybeSingle();b.disabled=false;
    if(e||!h){alert("No se pudo descargar: "+(e?.message||"sin datos"));return;}
    download(new Blob([JSON.stringify({app:"Element Park",exportado:h.guardado_en,data:h.data},null,1)],{type:"application/json"}),`element-park_version_${String(h.guardado_en).slice(0,16).replace(/[:T]/g,"-")}.json`);});
  box.querySelectorAll("[data-hrest]").forEach(b=>b.onclick=async()=>{const h=data.find(x=>String(x.hist_id)===b.dataset.hrest);
    if(!confirm(`¿Restaurar los datos como estaban el ${new Date(h.guardado_en).toLocaleString("es-AR")}?\n\nLo actual NO se pierde: queda en el historial y podés volver a esa versión.`))return;
    b.disabled=true;clearTimeout(saveTimer);
    const {error:e}=await sb.rpc("ep_restaurar",{p_hist_id:+b.dataset.hrest});
    if(e){alert("No se pudo restaurar: "+e.message);b.disabled=false;return;}
    alert("Versión restaurada. La página se va a recargar.");location.reload();});
}
function download(blob,name){const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),2000);}
